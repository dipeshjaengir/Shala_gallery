# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Configuration (Target Database: Shala_gallery)
# Cluster: cluster0.mf4qcwy.mongodb.net
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mf4qcwy.mongodb.net/Shala_gallery?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=ieyxmxrp
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=shala_gallery
CLOUDINARY_UPLOAD_PRESET=shala_gallery

# Admin Authentication
ADMIN_EMAIL=your_admin_email@example.com
JWT_SECRET=your_jwt_secret_key_here

# Optional Email Provider Configuration (for inquiries & notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SHALAGALLERY <noreply@shalagallery.com>
